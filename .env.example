NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Set to true only when the API is behind the trusted production reverse proxy.
TRUST_PROXY=false
DATABASE_URL=postgresql://lumify:lumify@localhost:5432/lumify?schema=public
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=development-only-secret-change-before-production-0000
JWT_REFRESH_SECRET=development-only-refresh-secret-change-before-production-0000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Set to true only in a non-public staging environment. Never enable in production.
EXPOSE_OTP_IN_RESPONSE=false
# Required in production. Development sends through Resend when both values are present.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Required in production for private Cloudflare R2 object storage.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_TTL_SECONDS=900
# Optional idempotent administrator bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lumify Admin
