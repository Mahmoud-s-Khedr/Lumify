NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
DATABASE_URL=postgresql://lumify:replace-with-url-encoded-password@db:5432/lumify?schema=public
POSTGRES_DB=lumify
POSTGRES_USER=lumify
POSTGRES_PASSWORD=replace-with-a-long-random-password
LOG_LEVEL=info
CORS_ORIGIN=https://app.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
EXPOSE_OTP_IN_RESPONSE=false
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET_NAME=replace-with-private-bucket-name
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PRESIGNED_URL_TTL_SECONDS=900
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_NAME=Lumify Admin
