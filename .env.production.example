NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
DATABASE_URL=postgresql://lumify:replace-with-url-encoded-password@db:5432/lumify?schema=public
POSTGRES_DB=lumify
POSTGRES_USER=lumify
POSTGRES_PASSWORD=replace-with-a-long-random-password
LOG_LEVEL=info
CORS_ORIGIN=https://app.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Authentication rate limits. Limits count requests within each window in seconds.
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_IP_WINDOW_SECONDS=900
AUTH_REGISTER_EMAIL_LIMIT=3
AUTH_REGISTER_EMAIL_WINDOW_SECONDS=3600
AUTH_RESEND_IP_LIMIT=10
AUTH_RESEND_IP_WINDOW_SECONDS=900
AUTH_RESEND_EMAIL_LIMIT=3
AUTH_RESEND_EMAIL_WINDOW_SECONDS=900
AUTH_VERIFY_IP_LIMIT=20
AUTH_VERIFY_IP_WINDOW_SECONDS=900
AUTH_VERIFY_EMAIL_LIMIT=5
AUTH_VERIFY_EMAIL_WINDOW_SECONDS=600
# Nginx global per-IP rate limit. Used by deploy/render-nginx-config.sh.
NGINX_RATE_LIMIT=20r/s
NGINX_RATE_LIMIT_BURST=40
EXPOSE_OTP_IN_RESPONSE=false
EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET_NAME=replace-with-private-bucket-name
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PRESIGNED_URL_TTL_SECONDS=900
CERTIFICATE_JOB_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BACKEND_URL=https://api.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_NAME=Lumify Admin
