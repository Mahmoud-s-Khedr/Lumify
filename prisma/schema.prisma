generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT

  @@map("user_role")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY

  @@map("weekday")
}

enum RoundScheduleMode {
  WEEKLY
  CUSTOM

  @@map("round_schedule_mode")
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  CONFIRMED
  PAYMENT_REJECTED
  CANCELLATION_REQUESTED
  CANCELLED

  @@map("booking_status")
}

enum CourseReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("course_review_status")
}

model User {
  id            BigInt   @id @default(autoincrement())
  name          String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  contactInfo   Json?    @map("contact_info")
  avatarFileId  BigInt?  @unique @map("avatar_file_id")
  passwordHash  String   @map("password_hash")
  role          UserRole @default(STUDENT)
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  authTokens AuthToken[]
  authSessions AuthSession[]
  files      File[]      @relation("UploadedFiles")
  avatarFile File?       @relation("ProfileAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  bookings   Booking[]
  courseReviews CourseReview[]
  communityMessages CommunityMessage[] @relation("CommunityMessageSender")
  communityReadStates CommunityReadState[]

  @@map("users")
}

model AuthSession {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model AuthToken {
  id        BigInt        @id @default(autoincrement())
  userId    BigInt        @map("user_id")
  type      AuthTokenType
  tokenHash String        @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("auth_tokens")
}

model AuthRateLimit {
  action          String   @db.VarChar(50)
  keyHash         String   @map("key_hash") @db.Char(64)
  count           Int      @default(0)
  windowStartedAt DateTime @map("window_started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([action, keyHash])
  @@index([updatedAt])
  @@map("auth_rate_limits")
}

model PendingRegistration {
  email        String    @id @db.VarChar(255)
  name         String    @db.VarChar(255)
  phone        String    @db.VarChar(50)
  passwordHash String    @map("password_hash")
  otpHash      String    @map("otp_hash")
  otpExpiresAt DateTime  @map("otp_expires_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("pending_registrations")
}

model File {
  id           BigInt   @id @default(autoincrement())
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String?  @map("mime_type") @db.VarChar(255)
  sizeBytes    BigInt?  @map("size_bytes")
  uploadedById BigInt?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  uploadedBy   User?    @relation("UploadedFiles", fields: [uploadedById], references: [id])
  profileAvatarFor User? @relation("ProfileAvatar")
  courseImages CourseImage[]
  materials    RoundMaterial[]
  receipts     Booking[] @relation("ReceiptFile")
  communityMessageAttachments CommunityMessageAttachment[]
  activeCertificateTemplate CertificateTemplate? @relation("ActiveCertificateTemplate")
  certificateTemplateInspection CertificateTemplateInspection?
  generatedCertificateFor Certificate? @relation("GeneratedCertificatePdf")

  @@unique([storageKey])
  @@map("files")
}

model PaymentMethod {
  key         String    @id @db.VarChar(100)
  value       String
  description String
  bookings Booking[]

  @@map("payment_methods")
}

model Course {
  id                   BigInt        @id @default(autoincrement())
  title                String        @db.VarChar(255)
  description          String?
  price                Decimal       @db.Decimal(10, 2)
  outcomes             Json?
  skills               Json?
  prerequisiteSkills   Json?         @map("prerequisite_skills")
  prerequisiteCourseId BigInt?       @map("prerequisite_course_id")
  demoVideoUrl         String?       @map("demo_video_url")
  archived             Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")
  prerequisiteCourse   Course?       @relation("CoursePrerequisite", fields: [prerequisiteCourseId], references: [id])
  dependentCourses     Course[]      @relation("CoursePrerequisite")
  images               CourseImage[]
  rounds               CourseRound[]
  reviews              CourseReview[]
  communityMessages    CommunityMessage[]
  communityReadStates  CommunityReadState[]

  @@index([archived])
  @@map("courses")
}

model CourseImage {
  id        BigInt   @id @default(autoincrement())
  courseId  BigInt   @map("course_id")
  fileId    BigInt   @map("file_id")
  sortOrder Int?     @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id])
  file      File     @relation(fields: [fileId], references: [id])

  @@unique([courseId, fileId])
  @@index([courseId, sortOrder])
  @@map("course_images")
}

model CourseRound {
  id                  BigInt          @id @default(autoincrement())
  courseId            BigInt          @map("course_id")
  startDate           DateTime        @db.Date @map("start_date")
  endDate             DateTime        @db.Date @map("end_date")
  capacity            Int
  scheduleMode        RoundScheduleMode @default(WEEKLY) @map("schedule_mode")
  liveJoinUrl         String?         @map("live_join_url")
  whatsappUrl         String?         @map("whatsapp_url")
  joiningInstructions String?         @map("joining_instructions")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at")
  course              Course          @relation(fields: [courseId], references: [id])
  schedules           RoundSchedule[]
  occurrences         RoundOccurrence[]
  materials           RoundMaterial[]
  bookings            Booking[]
  sessions            Session[]

  @@index([courseId, startDate])
  @@map("course_rounds")
}

model RoundSchedule {
  id        BigInt      @id @default(autoincrement())
  roundId   BigInt      @map("round_id")
  weekday   Weekday
  startTime DateTime    @db.Time(0) @map("start_time")
  endTime   DateTime    @db.Time(0) @map("end_time")
  createdAt DateTime    @default(now()) @map("created_at")
  round     CourseRound @relation(fields: [roundId], references: [id])

  @@index([roundId, weekday])
  @@map("round_schedules")
}

model RoundOccurrence {
  id        BigInt      @id @default(autoincrement())
  roundId   BigInt      @map("round_id")
  startAt   DateTime    @map("start_at")
  endAt     DateTime    @map("end_at")
  createdAt DateTime    @default(now()) @map("created_at")
  round     CourseRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, startAt])
  @@map("round_occurrences")
}

model RoundMaterial {
  id          BigInt      @id @default(autoincrement())
  roundId     BigInt      @map("round_id")
  title       String      @db.VarChar(255)
  fileId      BigInt?     @map("file_id")
  externalUrl String?     @map("external_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  round       CourseRound @relation(fields: [roundId], references: [id])
  file        File?       @relation(fields: [fileId], references: [id])

  @@map("round_materials")
}

model Booking {
  id               BigInt        @id @default(autoincrement())
  studentId        BigInt        @map("student_id")
  roundId          BigInt        @map("round_id")
  price            Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING_PAYMENT)
  paymentMethodKey String?       @map("payment_method_key") @db.VarChar(100)
  paymentMethodSnapshot Json?    @map("payment_method_snapshot")
  transactionReference String?   @map("transaction_reference")
  receiptFileId    BigInt?       @map("receipt_file_id")
  adminNote        String?       @map("admin_note")
  reviewedAt       DateTime?     @map("reviewed_at")
  cancellationReason String?     @map("cancellation_reason")
  cancelledAt      DateTime?     @map("cancelled_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")
  student          User          @relation(fields: [studentId], references: [id])
  round            CourseRound   @relation(fields: [roundId], references: [id])
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodKey], references: [key])
  receiptFile      File?         @relation("ReceiptFile", fields: [receiptFileId], references: [id])
  certificate      Certificate?

  @@unique([studentId, roundId])
  @@index([roundId, status])
  @@map("bookings")
}

model CertificateTemplate {
  id          Int      @id @default(1)
  fileId      BigInt   @unique @map("file_id")
  fieldReport Json     @map("field_report")
  inspectedAt DateTime @map("inspected_at")
  activatedAt DateTime @default(now()) @map("activated_at")
  file        File     @relation("ActiveCertificateTemplate", fields: [fileId], references: [id], onDelete: Restrict)

  @@map("certificate_templates")
}

model CertificateTemplateInspection {
  fileId      BigInt   @id @map("file_id")
  fieldReport Json     @map("field_report")
  inspectedAt DateTime @default(now()) @map("inspected_at")
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("certificate_template_inspections")
}

model Certificate {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @map("public_id") @db.VarChar(64)
  bookingId         BigInt    @unique @map("booking_id")
  fileId            BigInt    @unique @map("file_id")
  completionDate    DateTime  @db.Date @map("completion_date")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  emailDeliveredAt  DateTime? @map("email_delivered_at")
  deliveryClaimedAt DateTime? @map("delivery_claimed_at")
  deliveryClaimToken String?  @map("delivery_claim_token") @db.VarChar(36)
  deliveryAttempts  Int       @default(0) @map("delivery_attempts")
  lastDeliveryError String?   @map("last_delivery_error")
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  file              File      @relation("GeneratedCertificatePdf", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([publicId])
  @@index([emailDeliveredAt, deliveryClaimedAt])
  @@map("certificates")
}

model CourseReview {
  id        BigInt             @id @default(autoincrement())
  courseId  BigInt             @map("course_id")
  studentId BigInt             @map("student_id")
  rating    Int
  comment   String
  status    CourseReviewStatus @default(PENDING)
  adminNote String?            @map("admin_note")
  reviewedAt DateTime?         @map("reviewed_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")
  course    Course             @relation(fields: [courseId], references: [id])
  student   User               @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
  @@index([courseId, status, createdAt])
  @@index([studentId])
  @@map("course_reviews")
}

model CommunityMessage {
  id        BigInt    @id @default(autoincrement())
  courseId  BigInt    @map("course_id")
  senderId  BigInt    @map("sender_id")
  content   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  course    Course    @relation(fields: [courseId], references: [id])
  sender    User      @relation("CommunityMessageSender", fields: [senderId], references: [id])
  attachments CommunityMessageAttachment[]

  @@index([courseId, createdAt, id])
  @@index([senderId])
  @@map("community_messages")
}

model CommunityMessageAttachment {
  id        BigInt           @id @default(autoincrement())
  messageId BigInt           @map("message_id")
  fileId    BigInt           @unique @map("file_id")
  createdAt DateTime         @default(now()) @map("created_at")
  message   CommunityMessage @relation(fields: [messageId], references: [id])
  file      File             @relation(fields: [fileId], references: [id])

  @@index([messageId])
  @@map("community_message_attachments")
}

model CommunityReadState {
  courseId           BigInt   @map("course_id")
  userId             BigInt   @map("user_id")
  lastReadMessageId  BigInt?  @map("last_read_message_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  course             Course   @relation(fields: [courseId], references: [id])
  user               User     @relation(fields: [userId], references: [id])

  @@id([courseId, userId])
  @@index([userId])
  @@map("community_read_states")
}

model Session {
  id           BigInt      @id @default(autoincrement())
  roundId      BigInt      @map("round_id")
  title        String      @db.VarChar(255)
  sessionDate  DateTime    @map("session_date")
  recordingUrl String?     @map("recording_url")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")
  round        CourseRound @relation(fields: [roundId], references: [id])

  @@index([roundId, sessionDate])
  @@map("sessions")
}
